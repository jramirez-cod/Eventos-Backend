# Copia este archivo como .env y completa los valores reales.

# PostgreSQL
# Si PostgreSQL corre en la misma maquina que Docker, usa:
# PGHOST=host.docker.internal
# Si esta en otra IP/hostname, conserva ese valor real.
PGHOST=localhost
PGPORT=5432
PGDATABASE=eventos
PGUSER=postgres
PGPASSWORD=changeme

# Aplicación
APP_NAME=Sistema Eventos API
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Solo para desarrollo local con puertos dinámicos. En producción debe ser false.
CORS_ALLOW_LOCALHOST_ANY_PORT=false

# Archivos de Eventos (5 MiB por defecto)
EVENT_FLYER_UPLOAD_DIR=uploads/eventos
EVENT_FLYER_MAX_BYTES=5242880

# Seguridad
SECRET_KEY=changeme-generate-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ISSUER=eventos-codip-api
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_CHANGE_TOKEN_EXPIRE_MINUTES=15
INITIAL_PASSWORD_CODE_EXPIRE_MINUTES=10
INITIAL_PASSWORD_CODE_LENGTH=6
TEMPORARY_DNI_LENGTH=8
RECOVERY_TOKEN_EXPIRE_MINUTES=30
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_HASH_ARGON2_TIME_COST=3
PASSWORD_HASH_ARGON2_MEMORY_COST=65536
PASSWORD_HASH_ARGON2_PARALLELISM=4

# Correo SMTP
EMAIL_ENABLED=false
EMAIL_PRINT_CODE_TO_CONSOLE=true
EMAIL_SENDER_USER_ID=1
EMAIL_FROM_NAME=Sistema Eventos CODIP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=20
SMTP_APP_PASSWORD=changeme

# Consultas de RUC, DNI y carne de extranjeria (Factiliza).
# Cada entorno debe usar su propio token. Nunca lo expongas al frontend.
FACTILIZA_BASE_URL=https://api.factiliza.com/v1
FACTILIZA_API_TOKEN=changeme
FACTILIZA_TIMEOUT_SECONDS=15

# Bootstrap del primer administrador (opcional, usado por scripts/bootstrap_security.py)
# Si se omiten, el script los solicita por entrada interactiva.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_EMAIL=admin@codip.pe
# BOOTSTRAP_ADMIN_PASSWORD=AdminSeguro1!
# BOOTSTRAP_ADMIN_NOMBRES=Administrador
# BOOTSTRAP_ADMIN_APELLIDOS=Eventos
# BOOTSTRAP_ADMIN_DOCUMENTO=00000000
